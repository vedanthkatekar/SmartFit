{
  "expo": {
    "name": "SmartFit",
    "slug": "smartfit-wardrobe-app",
    "description": "AI-powered digital wardrobe and outfit planner with virtual try-on, smart recommendations, and style learning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SmartFit to access your photos to add clothing items to your wardrobe"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
